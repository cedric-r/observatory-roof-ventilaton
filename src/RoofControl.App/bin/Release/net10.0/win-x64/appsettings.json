{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "RoofControl": "Debug"
      }
    }
  },
  "Timezone": "Europe/Copenhagen",
  "Talon6": {
    "PortName": "COM4",
    "BaudRate": 9600,
    "EncoderTicksMax": 50000,
    "SafetyEnabled": true,
    "ReadTimeoutSeconds": 10,
    "WriteTimeoutSeconds": 10
  },
  "WeatherSource": {
    "Url": "http://192.168.1.100/cgi-bin/cgiLastData",
    "Format": "KeyValue",
    "TimeoutSeconds": 10
  },
  "Polling": {
    "WeatherIntervalSeconds": 30,
    "RoofStatusIntervalSeconds": 5,
    "DecisionIntervalSeconds": 60
  },
  "RoofRules": {
    "Daytime": {
      "StartTime": "06:00",
      "EndTime": "20:00",
      "TargetOpenPercent": 20.0,
      "NightfallHysteresisSeconds": 30,
      "OpenConditions": {
        "MinAmbientTemp": 5.0,
        "MaxAmbientTemp": 40.0,
        "SkyTempMin": -50.0,
        "SkyTempMax": -1.0,
        "MaxHumidity": 75.0,
        "RainThreshold": 400,
        "RainSafetyThreshold": 0,
        "WindThreshold": 10.0,
        "IgnoreCloudWatcherSafe": false
      }
    }
  },
  "Hysteresis": {
    "CloseDelaySeconds": 120
  },
  "FailSafe": {
    "MaxWeatherAgeSeconds": 90,
    "MaxRetries": 3,
    "BaseDelayMs": 500
  },
  "MaintenanceMode": {
    "Enabled": false
  },
  "Retry": {
    "MaxRetries": 2,
    "BaseDelayMs": 500
  },
  "Serialization": {
    "StateFilePath": "/var/lib/roofcontrol/state.json"
  },
  "Override": {
    "FilePath": "/etc/roofcontrol/override.flag"
  }
}
