{
  /*
   * RoofControl — Example Configuration
   * ====================================
   * Copy this to src/RoofControl.App/appsettings.json and customize.
   * On Linux, a config in /etc/roofcontrol/appsettings.json can also be used.
   *
   * All times are 24-hour HH:mm format.
   * All temperatures are in degrees Celsius.
   */

  /* ── Serilog Logging ─────────────────────────────────────────────── */
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "RoofControl": "Debug"
      }
    }
  },

  /* ── Timezone ────────────────────────────────────────────────────── */
  /* Used for day/night detection. Must match a valid IANA timezone
     or Windows timezone ID on the host OS. */
  "Timezone": "Europe/Copenhagen",

  /* ── Talon6 Serial Port ──────────────────────────────────────────── */
  "Talon6": {
    "PortName": "COM4",
    "BaudRate": 9600,
    "EncoderTicksMax": 50000,
    "SafetyEnabled": true,
    "ReadTimeoutSeconds": 10,
    "WriteTimeoutSeconds": 10
  },

  /* ── Weather Source (AAG CloudWatcher) ───────────────────────────── */
  "WeatherSource": {
    "Url": "http://192.168.1.100/cgi-bin/cgiLastData",
    "Format": "KeyValue",
    "TimeoutSeconds": 10
  },

  /* ── Polling Intervals ───────────────────────────────────────────── */
  "Polling": {
    "WeatherIntervalSeconds": 30,
    "RoofStatusIntervalSeconds": 5,
    "DecisionIntervalSeconds": 60
  },

  /* ── Roof Rules ──────────────────────────────────────────────────── */
  "RoofRules": {
    "Daytime": {
      "StartTime": "06:00",
      "EndTime": "20:00",
      "TargetOpenPercent": 20.0,
      "NightfallHysteresisSeconds": 30,
      "OpenConditions": {
        "MinAmbientTemp": 5.0,
        "MaxAmbientTemp": 40.0,
        "SkyTempMin": -50.0,
        "SkyTempMax": -1.0,
        "MaxHumidity": 75.0,
        "RainThreshold": 400,
        "RainSafetyThreshold": 0,
        "WindThreshold": 10.0,
        "IgnoreCloudWatcherSafe": false
      }
    }
  },

  /* ── Hysteresis (Debounce) ───────────────────────────────────────── */
  "Hysteresis": {
    "CloseDelaySeconds": 120
  },

  /* ── Fail-Safe ───────────────────────────────────────────────────── */
  "FailSafe": {
    "MaxWeatherAgeSeconds": 90,
    "MaxRetries": 3,
    "BaseDelayMs": 500
  },

  /* ── Maintenance Mode ────────────────────────────────────────────── */
  "MaintenanceMode": {
    "Enabled": false
  },

  /* ── Retry on Transient Errors ───────────────────────────────────── */
  "Retry": {
    "MaxRetries": 2,
    "BaseDelayMs": 500
  },

  /* ── State Persistence ───────────────────────────────────────────── */
  "Serialization": {
    "StateFilePath": "/var/lib/roofcontrol/state.json"
  },

  /* ── Operator Override ───────────────────────────────────────────── */
  "Override": {
    "FilePath": "/etc/roofcontrol/override.flag"
  }
}
